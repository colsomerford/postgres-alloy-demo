remotecfg {
    url = sys.env("FM_URL")

    basic_auth {
        username = sys.env("FM_USERNAME")
        password = sys.env("GCLOUD_RW_API_KEY")
    }

    tls_config {  
        insecure_skip_verify = true  
    }  

    attributes = {"namespace" = "postgres-test-om"}
    poll_frequency = "1m"
}